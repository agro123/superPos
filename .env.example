# Copia este archivo como .env.local. La config web de Firebase NO es secreta:
# la seguridad depende de las Security Rules y de App Check (ver docs/architecture/security.md).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-superpos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-superpos
VITE_FIREBASE_STORAGE_BUCKET=demo-superpos.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# true = conecta Auth/Firestore/Storage a los emuladores locales (obligatorio con proyectos demo-*).
VITE_USE_EMULATORS=true

# Clave de sitio de reCAPTCHA Enterprise para App Check. Vacía = App Check desactivado.
VITE_APP_CHECK_SITE_KEY=
